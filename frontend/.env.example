# ─────────────────────────────────────────────────────────────────────────────
# HeadsetConnect Frontend — Environment Variables
# Copy this file to .env.local for local overrides (git-ignored)
# ─────────────────────────────────────────────────────────────────────────────

# Backend URL for production (Vercel deployment)
# Set this in Vercel: Project Settings → Environment Variables → VITE_BACKEND_URL
# Value should be just the host, NO https:// prefix and NO trailing slash.
# Example: VITE_BACKEND_URL=headsetconnect.onrender.com
#
# The frontend will automatically use:
#   wss://headsetconnect.onrender.com/ws        (WebSocket)
#   https://headsetconnect.onrender.com/api/*   (REST)
#
# Leave blank for local development (auto-detects localhost:8000)
VITE_BACKEND_URL=
